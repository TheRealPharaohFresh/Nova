# Copy to .env for local development. Never commit real keys.
# Runtime keys should be entered in Settings; they are stored via Electron safeStorage.

# Optional: default provider for development only
# NOVA_DEFAULT_PROVIDER=openai

# Do not put production API keys here.
# NOVA_OPENAI_API_KEY=
# NOVA_ANTHROPIC_API_KEY=
# NOVA_GOOGLE_API_KEY=
